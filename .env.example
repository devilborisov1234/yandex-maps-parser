# ==========================================================================
# Настройки сбора организаций из Яндекс Карт.
# Файл читается автоматически при запуске: python -m ymcontacts <команда>
# Меняете значение здесь — меняется поведение программы, код трогать не нужно.
# ==========================================================================

# ---------------------------------------------------------------------- город
YMC_CITY_NAME=Борисов
YMC_CITY_CENTER_LAT=54.2277
YMC_CITY_CENTER_LON=28.4850
# Радиус обхода в км и размер клетки сетки в км.
# Меньше клетка -> плотнее покрытие и больше запросов.
YMC_CITY_RADIUS_KM=7.0
YMC_CELL_SIZE_KM=2.2
# Ячейка для запросов по рубрикам: крупнее намеренно, иначе число запросов
# умножается на 115 рубрик. Меняйте, если хотите тоньше или быстрее.
YMC_RUBRIC_CELL_SIZE_KM=6.6
YMC_LANG=ru_BY
# Локаль браузера: BCP-47 с ДЕФИСОМ. ru_BY здесь ломает загрузку карт.
YMC_BROWSER_LOCALE=ru-BY
# Домен карт: yandex.by (Беларусь), yandex.ru (Россия)
YMC_MAPS_HOST=https://yandex.by
# Сегмент города в адресе страницы поиска. Обязателен: без него Яндекс
# отвечает 404. Пусто = взять транслитерацию YMC_CITY_NAME (Борисов -> borisov).
YMC_MAPS_CITY_SEGMENT=borisov

# ------------------------------------------------------------------------ темп
# Пауза между запросами — случайное значение из этого диапазона, секунды.
# Меньше = быстрее и рискованнее. Для домашнего интернета 4-9 секунд нормально.
YMC_DELAY_MIN=4.0
YMC_DELAY_MAX=9.0
# Каждые N запросов — длинная передышка, секунды.
YMC_BREAK_EVERY=30
YMC_BREAK_MIN=45.0
YMC_BREAK_MAX=120.0
# Потолок запросов в час — страховка от слишком агрессивного темпа.
YMC_MAX_REQUESTS_PER_HOUR=420
# Сколько ждать после капчи, минут.
YMC_COOLDOWN_ON_CAPTCHA_MIN=45

# --------------------------------------------------------------------- браузер
# chrome — использовать установленный Google Chrome; пусто — бандл Playwright.
YMC_BROWSER_CHANNEL=chrome
YMC_HEADLESS=true
YMC_BROWSER_WIDTH=1440
YMC_BROWSER_HEIGHT=900

# ---------------------------------------------------------------- этап 2: сайты
# Сколько сайтов обрабатывать одновременно. Больше 4 — уже заметная нагрузка.
YMC_SITE_WORKERS=3
YMC_SITE_DELAY_MIN=2.0
YMC_SITE_DELAY_MAX=5.0
YMC_SITE_TIMEOUT=20.0
YMC_MAX_PAGES_PER_SITE=3

# ---------------------------------------------------------------------- прочее
YMC_LOG_LEVEL=INFO
